# ---------------------------------------------------------------------------
# Demo mode (default)
# ---------------------------------------------------------------------------
# When true -- or when this variable is simply absent -- the app serves every
# API call from an in-browser mock seeded with dummy data. No backend and no
# database are required, which is what makes the static Vercel deploy work.
VITE_USE_MOCK_API=true

# ---------------------------------------------------------------------------
# Real backend
# ---------------------------------------------------------------------------
# Set VITE_USE_MOCK_API=false to talk to the Express server in SPAM_Backend,
# and point this at wherever that server is running.
VITE_API_BASE_URL=http://localhost:3000
